# 云端机器 .env 样例（复制为项目根 .env 后填写；此文件不含任何真实密钥）
# 本机开发用不到这些——这是给腾讯云部署用的。

# 访问口令（必填，不配拒绝启动；告诉朋友的就这个）
MYRAG_CLOUD_PASSWORD=

# 硅基流动密钥（不配则搜索降级为关键词模式，不报错）
SILICONFLOW_API_KEY=

# 以下有默认值，一般不用动
# MYRAG_CLOUD_PORT=8766
# MYRAG_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# MYRAG_EMBED_MODEL=BAAI/bge-m3
# MYRAG_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
