# ================================================================
# MyRag · 不进版本库的东西
# 原则：仓库里只放「代码 + 文档」，运行数据一律不进
# ================================================================

# 运行数据：数据库 / 原文 / 配图 / staging / 日志 / 备份
# 里面是使用者自己收的文章与配图，属于个人数据，绝不能公开
data/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# 浏览器测试与临时产物
.playwright-cli/
*.bak
*.bak-*

# 本机配置（端口/路径/token；模板见 .env.example）—— 不该进版本库
.env
