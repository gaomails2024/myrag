# ================================================================
# MyRag 配置示例
#
# 用法：复制成 .env 放在项目根，按需修改。不用也行 —— 全部有默认值。
# 格式：一行一对 KEY=value，不要有空格，值可带引号。
# 优先级：环境变量 > .env > 代码默认值
# （所以临时改端口可以直接 MYRAG_PORT=9000 bash scripts/start.sh）
# ================================================================

# ---- 服务 ----
# 只监听本机。要让同局域网的其他设备访问，改成 0.0.0.0（注意：无鉴权，别暴露到公网）
MYRAG_HOST=127.0.0.1
MYRAG_PORT=8765

# ---- 数据存放 ----
# 默认全部在 <项目根>/data。想挪到大盘就取消注释并改路径。
# MYRAG_DATA_DIR=/Volumes/BigDisk/myrag
# MYRAG_DB_PATH=/Volumes/BigDisk/myrag/wxk.db
# MYRAG_STAGE_DIR=/Volumes/BigDisk/myrag/_stage

# ---- Embedding 模型 ----
# 权重已缓存时可完全离线运行；这一项用于手动指定权重目录（优先级最高）
# MYRAG_MODEL_PATH=~/.cache/modelscope/models/BAAI--bge-m3/snapshots/master
# 权重下载源：modelscope（默认，国内快）｜ huggingface
MYRAG_MODEL_SOURCE=modelscope

# ---- 抓取脚本 ----
# 通常不用填。系统会自动找：仓库 skill/scripts/wx_fetch.py → 已安装的 Skill 位置。
# 只有放在非常规位置时才需要显式指定。
# MYRAG_FETCH_SCRIPT=/path/to/wx_fetch.py

# ---- GitHub 核查（可选，只为提高 API 限额）----
# 不带也能核查，只是每小时请求数少
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
